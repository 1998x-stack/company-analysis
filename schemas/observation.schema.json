{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed quantitative observation",
  "type": "object",
  "required": [
    "company_id",
    "metric_id",
    "period",
    "value_type",
    "evidence_ids"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "value_type": {
      "enum": [
        "reported",
        "estimated",
        "calculated",
        "disputed",
        "unavailable"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "scope": {
      "type": "string"
    },
    "assumption": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "formula_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
